# ==========================================================================
# SentinelAI — Environment Configuration
# Copy to `.env` and adjust. NEVER commit the real .env file.
# ==========================================================================

# ---- Application ----
APP_NAME=SentinelAI
APP_ENV=development                 # development | staging | production
DEBUG=true
API_V1_PREFIX=/api/v1
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
LOG_LEVEL=INFO                      # DEBUG | INFO | WARNING | ERROR

# ---- Security / Auth ----
SECRET_KEY=change-me-to-a-64-char-random-hex-string
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7
ALGORITHM=HS256
# Comma-separated list of allowed CORS origins
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ---- Database (PostgreSQL) ----
POSTGRES_USER=sentinel
POSTGRES_PASSWORD=sentinel_secret
POSTGRES_DB=sentinelai
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
# Full async URL is derived automatically; override only if needed.
# DATABASE_URL=postgresql+asyncpg://sentinel:sentinel_secret@localhost:5432/sentinelai

# ---- Redis (event bus / caching) ----
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0

# ---- Inference / Models ----
DEVICE=auto                        # auto | cuda | cpu
YOLO_MODEL=yolov8n.pt              # yolov8n/s/m/l/x.pt — auto-downloaded by Ultralytics
DETECTION_CONF_THRESHOLD=0.35
DETECTION_IOU_THRESHOLD=0.5
TRACKER=bytetrack                  # bytetrack | deepsort
FRAME_STRIDE=1                     # process every Nth frame
MAX_INFERENCE_FPS=25
MODELS_DIR=./models

# ---- Threat Engine thresholds ----
LOITERING_SECONDS=30
ABANDONED_OBJECT_SECONDS=25
CROWD_THRESHOLD=8
RUNNING_SPEED_PX_PER_S=350

# ---- Alerts ----
ALERTS_ENABLED=true
# Email (SMTP)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
ALERT_EMAIL_TO=
# Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ---- Storage ----
DATA_DIR=./data
SNAPSHOT_DIR=./data/snapshots
RECORDING_DIR=./data/recordings
HEATMAP_DIR=./data/heatmaps

# ---- Frontend (Vite) ----
VITE_API_BASE_URL=http://localhost:8000
VITE_WS_BASE_URL=ws://localhost:8000
